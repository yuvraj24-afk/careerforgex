# ==============================================================================
# CareerForgeX — Environment Variable Template
# Copy this file to .env or .env.local for local execution.
# NEVER commit real credentials, tokens, or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER (Required)
# ------------------------------------------------------------------------------
# Purpose: The public base URL of the web application.
# Scope: Client & Server (NEXT_PUBLIC_ prefix).
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Purpose: Runtime environment indicator.
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Purpose: Connection string for Prisma ORM.
# Local Development: Use SQLite (file:./dev.db) for instant zero-config setup.
# Production (Supabase / PostgreSQL): Set connection pooler string.
# Scope: Server only.
DATABASE_URL="file:./dev.db"

# Purpose: Direct PostgreSQL connection string for database migrations (Supabase/Neon).
# Scope: Server only (Required only in production).
DIRECT_URL=""

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSIONS (Required)
# ------------------------------------------------------------------------------
# Purpose: 32+ byte cryptographic secret for signing user & admin JWT session cookies.
# Scope: Server only.
# Generate via: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret-for-production"

# Default seeded credentials (Overridden after initial login)
ADMIN_DEFAULT_EMAIL="admin@careerforgex.com"
ADMIN_DEFAULT_PASSWORD="AdminCareerForgeX2026!"

# ------------------------------------------------------------------------------
# 4. SCHEDULER & AUTOPILOT WORKER (Required for automated ingestion)
# ------------------------------------------------------------------------------
# Purpose: Bearer token secret required to trigger /api/cron/* endpoints externally.
# Scope: Server only.
CRON_SECRET="change-this-to-a-secure-random-cron-secret"
WORKER_SECRET="change-this-to-a-secure-random-worker-secret"

# Purpose: Polling frequency of the background worker daemon in milliseconds (default: 60000ms = 1 min).
# Scope: Server only.
WORKER_INTERVAL_MS=60000

# ------------------------------------------------------------------------------
# 5. AI EXTRACTION & FOUNDATION MODELS (Optional)
# ------------------------------------------------------------------------------
# Purpose: Set to "true" to use live LLMs for parsing unformatted text.
# When "false" or omitted, CareerForgeX uses high-precision deterministic rules with zero API cost.
# Scope: Server only.
ENABLE_LIVE_AI_EXTRACTION="false"
AI_PROVIDER="openai" # Options: openai | gemini | anthropic
AI_PROVIDER_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. SUPABASE CLIENT KEYS (Optional - when using Supabase Auth/Storage)
# ------------------------------------------------------------------------------
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 7. EMAIL & SEARCH APIS (Optional)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER_KEY=""
EMAIL_FROM="CareerForgeX <notifications@careerforgex.com>"
SEARCH_API_KEY=""
